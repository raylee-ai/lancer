# Normalize all text files to LF so checkouts on Windows (core.autocrlf=true)
# do not fail `pnpm format:check` (Prettier enforces endOfLine: "lf").
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp4 binary
*.webm binary
*.mov binary
*.mp3 binary
*.wav binary
*.zip binary
*.gz binary
*.tgz binary
*.dmg binary
*.exe binary
*.dll binary
*.node binary
*.wasm binary
*.pdf binary
